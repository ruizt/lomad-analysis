# The sims/Dockerfile installs the lomad package from GitHub and does NOT copy
# the build context, so nothing here is strictly required for the image. These
# rules simply keep the build context small and fast to send to the builder.

# Version control
.git
.gitignore

# RStudio / R user files
.Rproj.user
*.Rproj
.Rhistory
.RData
.Renviron
.Ruserdata
.positai
.claude

# Simulation results and large data (never needed in the image)
_*
**/results/
_img/
_mb-data/
scratch/

# Docs and notebooks
docs/
**/*.qmd

# OS junk
.DS_Store
Thumbs.db

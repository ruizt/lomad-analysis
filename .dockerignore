# Keeps the build context small. The only thing the image actually needs from
# the context is simulations/_build/lomad.tar.gz, which is explicitly kept
# below -- everything else here is exclusion.

# Version control
.git
.gitignore

# RStudio / R user files
.Rproj.user
*.Rproj
.Rhistory
.RData
.Renviron
.Ruserdata
.positai
.claude

# Simulation results and large data (never needed in the image)
**/_*
**/results/
scratch/

# ...except the locally built package source, which is the whole point
!simulations/_build
!simulations/_build/**

# Docs and notebooks
docs/
**/*.qmd

# OS junk
.DS_Store
Thumbs.db
